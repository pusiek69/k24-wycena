{
  "name": "k24-wycena",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Kamieniarstwo 24h — kreator szybkiej wyceny blatu (statyczna aplikacja)",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/sprawdz-bundle.mjs",
    "sprawdz": "node scripts/sprawdz-bundle.mjs",
    "preview": "vite preview --port 4173",
    "cennik": "node scripts/build-katalog.mjs",
    "cennik:sprawdz": "node scripts/build-katalog.mjs --sprawdz",
    "ceny:audyt": "node scripts/audyt-cen.mjs",
    "podglad": "npm run build:podglad && node scripts/podglad-jednoplikowy.mjs",
    "build:podglad": "vite build --config vite.podglad.config.js",
    "worker": "node scripts/build-worker.mjs",
    "wdroz:worker": "node scripts/build-worker.mjs && npx wrangler deploy",
    "sprawdz:asystent": "node scripts/sprawdz-asystenta.mjs",
    "checklist": "node scripts/checklist.mjs",
    "cennik:dodaj": "node scripts/cennik-serwer.mjs",
    "pretest": "node scripts/build-worker.mjs",
    "test": "node --test scripts/test-*.mjs",
    "galeria": "node scripts/galeria.mjs",
    "galeria:sprawdz": "node scripts/galeria.mjs --sprawdz",
    "ceny:tresc": "node scripts/ceny-tresc.mjs",
    "sitemap": "node scripts/sitemap-lastmod.mjs",
    "gbp": "node scripts/gbp-grafiki.mjs",
    "wyprzedaz": "node scripts/strona-wyprzedazy.mjs",
    "spieki": "node scripts/strona-spieki.mjs",
    "przeglad": "node scripts/przeglad.mjs",
    "sprawdz-wyprzedaz": "node scripts/sprawdz-wyprzedaz-liczby.mjs",
    "konglomeraty": "node scripts/strona-konglomeraty.mjs",
    "miasta": "node scripts/strony-miast.mjs"
  },
  "devDependencies": {
    "sharp": "^0.35.3",
    "vite": "^7.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}
